{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shortkohdz",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shortkohdz-db",
      "database_id": "311c60a5-1363-4f45-a7b0-e427efd65904",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "shortkohdz.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": false
}
